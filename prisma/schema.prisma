generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Item {
  id         Int             @id @default(autoincrement())
  name       String          @unique
  number     String          @unique
  type       String
  brand      String
  weight     Int
  stock      Int             @default(0)
  palletQty  Int             @map("pallet_qty")
  locations  ItemLocation[]
  orders     ItemOrder[]
  containers ItemContainer[]

  @@map("items")
}

model Location {
  id             Int            @id @default(autoincrement())
  name           String         @unique
  utn            String?
  zone           String
  warehouseId    String         @default("024") @map("warehouse_id")
  warehouseIndex Int            @map("warehouse_index")
  items          ItemLocation[]

  @@map("locations")
}

model User {
  id       Int        @id @default(autoincrement())
  username String     @unique
  password String
  email    String     @unique
  fullName String     @unique @map("full_name")
  nickname String     @unique
  branch   String     @default("024")
  role     Role       @default(USER)
  orders   Order[]
  notes    Note[]     @relation("UserNotes")
  status   UserStatus @default(ACTIVE)

  @@map("users")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum Role {
  USER
  ADMIN
}

model Container {
  id           Int             @id @default(autoincrement())
  number       String          @unique
  poNumbers    String[]
  expectedDate DateTime?       @map("expected_date")
  receivedDate DateTime        @default(now()) @map("received_date")
  items        ItemContainer[]

  @@map("containers")
}

model Order {
  id          Int         @id @default(autoincrement())
  orderNumber String      @unique @map("order_number")
  pieces      Int
  weight      Int
  palletCount Float       @map("pallet_count")
  userId      Int         @map("user_id")
  user        User        @relation(fields: [userId], references: [id])
  createdAt   DateTime    @default(now()) @map("created_at")
  items       ItemOrder[]

  @@map("orders")
}

model Note {
  id         Int      @id @default(autoincrement())
  message    String
  entityType String   @map("entity_type") // "item", "location", "order", "container", "user"
  entityId   Int      @map("entity_id")
  entityName String   @map("entity_name")
  date       DateTime @default(now())
  logId      String   @map("log_id")
  userId     Int      @map("user_id")
  user       User     @relation("UserNotes", fields: [userId], references: [id])

  @@map("notes")
}

model ItemLocation {
  id         Int @id @default(autoincrement())
  itemId     Int @map("item_id")
  locationId Int @map("location_id")
  stock      Int @default(0)

  // relation fields
  item     Item     @relation(fields: [itemId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@unique([itemId, locationId])
  @@map("items_locations")
}

model ItemContainer {
  id          Int @id @default(autoincrement())
  containerId Int @map("container_id")
  itemId      Int @map("item_id")
  quantity    Int @default(1)

  container Container @relation(fields: [containerId], references: [id])
  item      Item      @relation(fields: [itemId], references: [id])

  @@unique([containerId, itemId])
  @@map("items_containers")
}

model ItemOrder {
  id       Int @id @default(autoincrement())
  itemId   Int @map("item_id")
  orderId  Int @map("order_id")
  quantity Int

  // relation fields
  item  Item  @relation(fields: [itemId], references: [id])
  order Order @relation(fields: [orderId], references: [id])

  @@unique([itemId, orderId])
  @@map("items_orders")
}
